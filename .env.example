# Copy to .env for local development. Every value is optional locally.

DEBUG=true
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Neon Postgres (leave unset to use local db.sqlite3)
# DATABASE_URL=postgres://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Cloudflare R2 (leave R2_BUCKET_NAME unset to store uploads in ./media)
# R2_ACCOUNT_ID=
# R2_BUCKET_NAME=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_DOMAIN=pub-xxxxxxxx.r2.dev
